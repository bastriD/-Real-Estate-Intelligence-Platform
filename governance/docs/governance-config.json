{
  "project": {
    "name": "chasse-immobiliere",
    "display_name": "Enterprise Real Estate Intelligence Platform",
    "domain": "real-estate",
    "environment": "homelab",
    "governance_version": "1.5.0"
  },

  "openmetadata": {
    "base_url_env": "OM_URL",
    "token_env": "OM_JWT_TOKEN",
    "database_service": "real-estate-postgresql",
    "database": "real_estate"
  },

  "governance": {
    "domains": {
      "enabled": true,
      "files": [
        "domains/real_estate_domains.json"
      ]
    },

    "data_products": {
      "enabled": true,
      "files": [
        "data-products/real_estate_market_intelligence.json"
      ]
    },

    "metrics": {
      "enabled": true,
      "files": [
        "metrics/real_estate_metrics.json"
      ]
    },

    "privacy_assignments": {
      "enabled": true,
      "files": [
        "tagging/real_estate_privacy_assignments.json"
      ]
    },

    "glossary": {
      "enabled": true,
      "file": "glossary/real_estate_glossary.json"
    },

    "glossary_assignments": {
      "enabled": true,
      "files": [
        "glossary/real_estate_glossary_assignments.json"
      ]
    },

    "classification": {
      "enabled": true,
      "files": [
        "tagging/real_estate_tags.json"
      ]
    },

    "data_layer": {
      "enabled": true,
      "files": [
        "tagging/real_estate_data_layers.json"
      ]
    },

    "certification": {
      "enabled": true,
      "files": [
        "tagging/real_estate_certifications.json"
      ]
    },

    "ownership": {
      "enabled": true,
      "files": [
        "ownership/real_estate_ownership.json"
      ]
    },

    "descriptions": {
      "enabled": true,
      "files": [
        "descriptions/real_estate_descriptions.json"
      ]
    },

    "lineage": {
      "enabled": true,
      "files": [
        "lineage/real_estate_lineage.json"
      ]
    },

    "data_quality": {
      "enabled": true,
      "files": [
        "quality/real_estate_quality.json"
      ]
    }
  },

  "target_schemas": [
    "real_estate",
    "warehouse",
    "analytics"
  ],

  "protected_schemas": [
    "raw",
    "staging",
    "migration_control",
    "Fil_Rouge_Depart"
  ],

  "policies": {
    "least_privilege": true,
    "privacy_by_design": true,
    "technical_accounts_are_not_business_owners": true,
    "do_not_modify_source_data": true,
    "do_not_delete_existing_metadata": true
  }
}