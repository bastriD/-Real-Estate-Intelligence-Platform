      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "real-estate-postgresql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH expected AS (SELECT dv.demande_version_key, ds.secteur_key FROM real_estate.demande_version_secteur link JOIN warehouse.dim_demande_version dv ON dv.id_demande_version_source = link.id_demande_version JOIN warehouse.dim_secteur ds ON ds.id_secteur_source = link.id_secteur), missing AS (SELECT * FROM expected EXCEPT SELECT * FROM warehouse.bridge_demande_version_secteur), extra AS (SELECT * FROM warehouse.bridge_demande_version_secteur EXCEPT SELECT * FROM expected) SELECT (SELECT COUNT(*) FROM missing) + (SELECT COUNT(*) FROM extra) AS value;",
          "refId": "A"
        }
      ],
      "title": "Search sector projection discrepancies",
      "type": "stat",
      "description": "Live count of missing plus extra warehouse search-sector links versus mapped OLTP relationships. May reflect a pending warehouse refresh; not a stored pipeline test result. Requires migration 018."
    },
    {
      "id": 13,
      "title": "Explicit sector evidence by staging batch",
      "description": "Latest 20 staging batches. Counts observed sector codes, not generation mode or matching quality. Missing codes are allowed. Requires migration 018.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "real-estate-postgresql"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "real-estate-postgresql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ingestion_batch, MAX(staged_at) AS last_staged_at, COUNT(*) AS staged_annonces, COUNT(*) FILTER (WHERE NULLIF(BTRIM(secteur_code), '') IS NOT NULL) AS with_sector_code, COUNT(*) FILTER (WHERE NULLIF(BTRIM(secteur_code), '') IS NULL) AS without_sector_code FROM staging.annonces GROUP BY ingestion_batch ORDER BY MAX(staged_at) DESC, ingestion_batch LIMIT 20;",
          "refId": "A"
        }
      ]
    }
