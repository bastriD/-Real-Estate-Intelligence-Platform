      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "real-estate-postgresql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM warehouse.dim_bien db JOIN real_estate.bien b ON b.id_bien = db.id_bien_source LEFT JOIN warehouse.dim_secteur ds ON ds.id_secteur_source = b.id_secteur WHERE db.is_current AND db.secteur_key IS DISTINCT FROM COALESCE(ds.secteur_key, 0);",
          "refId": "A"
        }
      ],
      "title": "Property sector projection discrepancies",
      "type": "stat",
      "description": "Live snapshot of warehouse versus OLTP sector projection. Nonzero can indicate a pending warehouse refresh. Unknown sector key 0 is valid. Requires migration 018."
    },
